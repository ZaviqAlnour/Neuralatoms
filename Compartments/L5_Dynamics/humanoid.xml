<mujoco model="NeuralAtoms_75kg_Humanoid">
    <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>
    <option integrator="RK4" timestep="0.01" gravity="0 0 -9.81"/>
    
    <default>
        <joint armature="1" damping="1" limited="true"/>
        <geom contype="1" conaffinity="1" condim="3" friction="0.5 0.1 0.1" rgba="0.8 0.6 0.4 1"/>
    </default>

    <asset>
        <texture name="texplane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .2 .3" width="512" height="512"/>
        <material name="matplane" texture="texplane" texrepeat="1 1" texuniform="true"/>
    </asset>

    <worldbody>
        <light directional="true" pos="0 0 10" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
        <geom name="floor" type="plane" size="0 0 .05" material="matplane"/>

        <body name="pelvis" pos="0 0 1.0">
            <freejoint name="root"/>
            <geom name="pelvis_geom" type="sphere" size="0.1" mass="10.0"/>
            
            <body name="torso" pos="0 0 0.2">
                <joint name="spine" type="ball" range="0 45"/>
                <geom name="torso_geom" type="capsule" size="0.1 0.2" mass="30.0"/>
                
                <!-- Arms and Head would go here -->
            </body>

            <body name="right_thigh" pos="0 -0.1 -0.1">
                <joint name="right_hip" type="ball" range="0 40"/>
                <geom name="right_thigh_geom" type="capsule" size="0.05 0.2" mass="10.0"/>
                <body name="right_shin" pos="0 0 -0.4">
                    <joint name="right_knee" type="hinge" pos="0 0 0.2" axis="0 1 0" range="0 150"/>
                    <geom name="right_shin_geom" type="capsule" size="0.04 0.2" mass="5.0"/>
                </body>
            </body>

            <body name="left_thigh" pos="0 0.1 -0.1">
                <joint name="left_hip" type="ball" range="0 40"/>
                <geom name="left_thigh_geom" type="capsule" size="0.05 0.2" mass="10.0"/>
                <body name="left_shin" pos="0 0 -0.4">
                    <joint name="left_knee" type="hinge" pos="0 0 0.2" axis="0 1 0" range="0 150"/>
                    <geom name="left_shin_geom" type="capsule" size="0.04 0.2" mass="5.0"/>
                </body>
            </body>
        </body>
    </worldbody>
</mujoco>
